{
	"name": "@cline/example-telegram-bridge",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Telegram bridge that drives local llama.cpp through the Cline SDK (Agent + ClineCore modes)",
	"scripts": {
